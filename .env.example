# === PostgreSQL ===
# Conexão de migração/seed (superuser)
MIGRATION_DATABASE_URL=postgres://postgres:SUA_SENHA@127.0.0.1:5432/cortecerto
# [DEPLOY] Com MIGRATION_DATABASE_URL definida, o servidor aplica migrações
# pendentes no boot (evita "relation ... does not exist"). Desligue com AUTO_MIGRATE=0.
AUTO_MIGRATE=
# Conexão de runtime da aplicação (role multi-tenant com RLS)
DATABASE_URL=postgres://cortecerto_app:SUA_SENHA@127.0.0.1:5432/cortecerto
# Senhas das roles criadas pela migração 005 (RN-005). Ajuste em produção.
CC_APP_DB_PASSWORD=SUA_SENHA
CC_READONLY_DB_PASSWORD=SUA_SENHA
CC_ADMIN_DB_PASSWORD=SUA_SENHA
# [PERSISTÊNCIA] Role com BYPASSRLS usada por asAdmin() para gravar (upsert/
# delete) no banco através da conexão de runtime. Sem ela, INSERT/UPDATE pela
# role da aplicação esbarra na Row Level Security. É a role criada pela
# migração 005. Ex.: ADMIN_DB_ROLE=cortecerto_admin
ADMIN_DB_ROLE=
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=cortecerto_app
PGPASSWORD=SUA_SENHA
PGDATABASE=cortecerto
# [SEGURANÇA] SSL dos hosts gerenciados (Render/Neon). A conexão é sempre
# criptografada; por padrão não validamos a cadeia (cert self-signed). Defina
# PGSSL_STRICT=1 para exigir validação estrita (requer CA confiável no host).
PGSSL_STRICT=
TZ=America/Sao_Paulo

# === AbacatePay ===
# [SEGURANÇA] Sem API_KEY o sistema cai em modo DEMO, que NÃO ativa plano
# pago. Em produção a API_KEY é obrigatória.
ABACATEPAY_API_KEY=
# [SEGURANÇA] Segredo do HMAC do webhook. OBRIGATÓRIO: sem esta chave o
# webhook responde 503 e NENHUM evento é processado (fail-closed).
# É um segredo, não uma chave pública — nunca exponha em painel ou log.
ABACATEPAY_WEBHOOK_HMAC_SECRET=
# Nome antigo, aceito por compatibilidade. Prefira ABACATEPAY_WEBHOOK_HMAC_SECRET.
ABACATEPAY_WEBHOOK_SECRET=
# A validação real é HMAC-SHA256 no header X-Webhook-Signature,
# comparado em tempo constante, com janela anti-replay de 5 minutos.
# Envie a query ?webhookSecret= apenas como solucao temporaria (depreciado).
# === TotalVoice SMS (v2.2) ===
TOTALVOICE_API_KEY=
TOTALVOICE_HOST=

# === Gmail Email via Nodemailer (v2.2) ===
# Gerar senha de app em: myaccount.google.com → Segurança → Senhas de app
GMAIL_USER=
GMAIL_PASS=
EMAIL_FROM=Corte Comigo

# === Bot Atendente de E-mail (v2.5) ===
# O bot usa GMAIL_USER/GMAIL_PASS acima (habilite IMAP no Gmail).
# Sem essas credenciais o bot roda em MODO DEMO (simula tudo no painel).
BOT_FORWARD_TO=atendimento@suaempresa.com
BOT_ASSISTANT_NAME=Equipe Corte Comigo
BOT_CHECK_SECONDS=30

# === Bot: IA Gemini (v2.5) ===
# Sem GEMINI_API_KEY o bot usa o classificador por palavras-chave
# (funciona mesmo assim). Com a chave, a IA decide e escreve as respostas.
# Chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# === App URL (v2.2) ===
APP_URL=http://localhost:3000

# === Super-Admin (v2.4) ===
SUPER_ADMIN_EMAIL=admin@cortecomigo.com
SUPER_ADMIN_HASH=
# [SEGURANÇA] IPs permitidos para super-admin (separados por vírgula)
# Ex: SUPER_ADMIN_IPS=192.168.1.1,10.0.0.1
# Deixe vazio para permitir qualquer IP (menos seguro)
SUPER_ADMIN_IPS=

# === LGPD / DPO (v3.0) ===
DPO_EMAIL=dpo@cortecomigo.com
DPO_NAME=
# [SEGURANÇA] Chave AES-256-GCM dos dados sensíveis em repouso (e-mail/telefone).
# SEM ESTA CHAVE O SERVIDOR NÃO SOBE (fail-closed) para nunca gravar PII em claro.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATENÇÃO: CC_CRYPT_INSECURE_PLAINTEXT=1 desabilita a criptografia.
# Use APENAS em demo/local SEM dados reais. Nunca em produção.
DB_ENCRYPT_KEY=

# === Server ===
PORT=3000
